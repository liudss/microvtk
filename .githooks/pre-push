#!/usr/bin/env bash
set -euo pipefail

remote_name="${1:-}"
remote_url="${2:-}"

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "${remote_ref}" == "refs/heads/master" ]]; then
    cat >&2 <<MSG
Blocked: direct push to remote master is not allowed.

Use the PR workflow instead:
  rtk git fetch origin
  rtk git switch master
  rtk git merge --ff-only origin/master
  rtk git switch -c <type>/<short-description>
  rtk git push -u ${remote_name:-origin} HEAD
  rtk gh pr create --base master

Remote: ${remote_name:-unknown} ${remote_url:-}
MSG
    exit 1
  fi
done
